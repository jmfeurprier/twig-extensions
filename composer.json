{
    "name" : "jmf/twig-extensions",
    "description" : "Collection of Twig extensions",
    "license": "mit",
    "type": "library",
    "require": {
        "jmf/twig-array": "^1.0",
        "jmf/twig-currency": "^1.0",
        "jmf/twig-inline": "^1.0",
        "jmf/twig-sort": "^1.0",
        "jmf/twig-time": "^1.0",
        "jmf/twig-type": "^1.0"
    },
    "require-dev": {
        "phing/phing": "^2.17",
        "phpmd/phpmd": "^2.10",
        "phpstan/phpstan": "^1.10",
        "phpunit/phpunit": "^11.1",
        "rector/rector": "^1.0",
        "squizlabs/php_codesniffer": "^3.8"
    },
    "config": {
        "audit": {
            "abandoned": "report"
        },
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
